# StudyNook server — copy to .env
# Handles auth, rooms, bookings. The Next.js client proxies /api/backend/* here.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/studynook?retryWrites=true&w=majority

# --- Auth (JWT) ---
# Use a long random string (e.g. openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here

# --- Frontend (CORS + OAuth redirect after login) ---
# Local:  http://localhost:3000
# Prod:   https://studynook-client-gamma.vercel.app
CLIENT_URL=http://localhost:3000

# --- Google OAuth (optional) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth callback — browser hits the client proxy, which forwards to this server route.
# Omit to default: {CLIENT_URL}/api/backend/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/backend/auth/google/callback
